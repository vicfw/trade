PORT=3001
# Futures market WS (BTCUSDT perpetual last price + klines)
LBANK_WS_URL=wss://uuws.lbank.com/ws/v3
# Futures public REST — ticker fallback
LBANK_PERP_REST_URL=https://lbkperp.lbank.com
TICKER_SYMBOL=BTCUSDT
PERP_PRODUCT_GROUP=SwapU
# Perp WS kline periods (1m required for tracking; HTF for suggest)
PERP_KLINE_PERIODS=1m,15m,1h,4h
# HTF intervals for suggest / indicators / chart
CANDLE_INTERVALS=15m,1h,4h
# SQLite path (relative to apps/api)
DB_PATH=data/trade.db
CORS_ORIGIN=http://localhost:3000

# Active LLM backend: gapgpt | moonshot (alias: kimi)
LLM_PROVIDER=gapgpt

# GapGPT (OpenAI-compatible proxy)
GAPGPT_API_KEY=
GAPGPT_BASE_URL=https://api.gapgpt.app/v1

# Moonshot / Kimi (OpenAI-compatible)
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# Reasoning models (e.g. deepseek-r1) often need 2–3+ minutes
LLM_TIMEOUT_MS=180000
LLM_CANDLE_WINDOW=60
SUGGEST_COOLDOWN_MS=15000
# Auto re-analysis after no_trade (2 hours)
ANALYSIS_INTERVAL_MS=7200000
# Retry after failed auto-analysis (5 minutes)
ANALYSIS_RETRY_MS=300000
# Seed risk settings if DB empty (web form also syncs these)
DEFAULT_ACCOUNT_BALANCE_USDT=10
DEFAULT_MAX_RISK_PERCENT=1
DEFAULT_MAX_LEVERAGE=5
